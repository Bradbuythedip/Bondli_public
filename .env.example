# ═══ BONDLI v4 Environment Variables ═══

# Alchemy API Key — enables smart money wallet tracking + enhanced RPC
# Get a free key at https://www.alchemy.com/ (100M compute units/mo free)
# This auto-configures both RPC_URL and smart money polling
ALCHEMY_API_KEY=

# Or use a custom RPC endpoint (overrides Alchemy)
# RPC_URL=https://your-rpc-endpoint.com

# PumpPortal API key (REQUIRED for the radar to receive trades).
# https://pumpportal.fun -> Generate API key, then fund that key's wallet with >= 0.02 SOL.
PUMPPORTAL_API_KEY=

# Where trades come from. onchain = decode pump.fun trades from the Solana program logs
# (free, no key needed, default when no key is set). auto = PumpPortal's keyed stream,
# which is METERED (about 0.01 SOL per 10,000 events), falling back to onchain when it
# refuses or goes silent. pumpportal = PumpPortal only.
RADAR_TRADE_SOURCE=onchain

# RPC whose websocket carries the on-chain trade stream. Default: public mainnet-beta.
# Use a Helius URL if the public endpoint drops; do NOT use Alchemy here (billed per byte).
RADAR_STREAM_RPC_URL=

# Trading wallet master seed (base58)
MASTER_SEED=

# Platform settings
API_PORT=3001
# Admin secret for the legacy routes. No default: unset means no override exists at all.
# Generate one with: npm run generate:secrets
API_SECRET=

# X/Twitter API bearer token (for social signal scoring)
X_BEARER_TOKEN=

# ═══ Bags.fm Integration ═══
# Get keys at https://dev.bags.fm
# API key — required for all Bags API calls (up to 10 keys per account)
BAGS_API_KEY=

# Partner wallet — earns revenue from volume of coins created through Bondli
BAGS_PARTNER_WALLET=

# Fee sweep interval (hours) — auto-claim accrued fees from Bags positions
# BAGS_FEE_SWEEP_HOURS=6

# Agent auth (optional — for agent wallet management)
# BAGS_AGENT_JWT=

# ═══ Hosted velocity (deploy/HOSTED_VELOCITY.md) ═══
# Seals trading-wallet keys at rest (64 hex chars). Production refuses to create wallets without it.
WALLET_ENCRYPTION_KEY=
# Signs the wallet sign-in tokens (64 hex chars).
JWT_SECRET=
# Where performance fees go. Must be a fresh wallet; the old default is refused.
PLATFORM_WALLET=
# 1 = mount /api/velocity/* and run one engine per user off the shared radar.
VELOCITY_HOSTED=0
# Per-user ledgers and state. On Railway, put this on a volume.
VELOCITY_DATA_DIR=data/velocity/users

# Mayhem tokens are never looked at. The bonding-curve flag byte offset (run tools/mayhem-probe.mjs to confirm).
MAYHEM_FLAG_OFFSET=81
# Same-name launches within this many minutes are copies (adverts), never bought.
COPYCAT_WINDOW_MIN=60
# Robinhood Chain (PONS launchpad). The hosted bot trades it beside pump.fun for users who fund the ETH wallet.
# VELOCITY_PONS=0 turns the feed off. PLATFORM_EVM_WALLET is where ETH fees go (a fresh 0x address you control).
VELOCITY_PONS=1
PONS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PONS_POLL_MS=3000
PLATFORM_EVM_WALLET=

# ── Arc (Circle's L1, chain 5042) ──
# An RPC with an API key (Alchemy, QuickNode, dRPC). The free rpc.mainnet.arc.io throttles transaction
# submission. Never commit the key: set it in the host's environment.
# ARC_RPC_URL=https://arc-mainnet.g.alchemy.com/v2/<key>
# VELOCITY_ARC=0 turns the Arc (Argus) feed off; ARC_POLL_MS is how often it reads the chain (blocks are ~500ms).
# ARC_POLL_MS=1500
# ARC_TOKEN_URL=https://explorer.arc.io/token/{ca}

# ── The house token: holders pay no performance fee ──
# $BNDLI is an SPL mint on Solana. Set BNDLI_MINT to it once it is launched; until then nothing is read
# and every fee is charged exactly as before. The balance is read against the user's OWN Solana
# wallet -- the pubkey they sign in with -- so there is nothing extra for them to connect and it
# counts whichever chain they trade. Cached for five minutes; an unreadable balance keeps the last
# good answer rather than charging a holder because a node blinked. Both token programs are read, so
# a Token-2022 mint works too. Uses RPC_URL. The old JEFF_MINT / JEFF_MIN_TOKENS / JEFF_SYMBOL names
# are still read as a fallback for one release and logged as such at boot; rename them.
# BNDLI_MINT=
# BNDLI_MIN_TOKENS=1
# BNDLI_SYMBOL=BNDLI
# The site links the ticker to its pump.fun page when the frontend is built with this set
# (VITE_JEFF_MINT is honoured as a fallback for one release):
# VITE_BNDLI_MINT=

# ── The launch banner on bondli.fun ($BNDLI) ──
# Pushed with: BONDLI_API=<railway url> ADMIN_SECRET=<same as Railway> node tools/launch-push.mjs --address 0x… --ticker FLY
# LAUNCH_FILE=            where the banner state lives; default: next to VELOCITY_DATA_DIR on the volume (launch.json)
# PONS_SCAN_BLOCKS=1500000  how far back the Robinhood Chain wallet's Transfer logs are scanned, once, to find tokens no index lists

# PRIORITY_FEE_SOL=0.0003   what each pump.fun transaction tips. 0.0003 is the default; every 0.0001
#                           off it saves about $0.02 a transaction and a round trip pays two. Raise it
#                           only if buys start missing the block on contested launches.
# VELOCITY_REQUIRE_SOCIALS=0  turn off the rule that refuses launches listing no twitter, telegram or
#                             website. On by default at every risk level. It only fires once the
#                             token's metadata has been read, so a young token is never refused for
#                             socials the radar simply has not fetched yet.
# X_BEARER_TOKEN=            X API bearer token. Without it the social verification is inert and the
#                            NO_SOCIALS rule falls back to "is a link present at all". With it, a handle
#                            the API says does not exist stops counting as a social link, and an account
#                            created in the last week raises FRESH_SOCIALS.
# X_DAILY_BUDGET=45          calls a day. The free X tier is 1500 a month; the check runs in the
#                            background on tokens that already cleared the base filter, once per handle.

# ── Alerting ──
# Where the engine's alerts go. Without it the alerter writes to the ledger and the status page and
# nowhere a person would see: a live router that failed to initialise, a flatten that left positions
# open, a position booked as a total loss, the governor freezing entries, gate files changed on disk.
# Paste a Slack incoming webhook, a Discord webhook (append /slack or not, either works), or an ntfy
# topic URL. The same body carries text, content and message, so one URL works whichever it is.
# Delivery is retried three times with a backoff; a failure is itself recorded as an alert.
# ALERT_WEBHOOK_URL=
# Public callouts: the bot's own live fills (tier CALLOUT_MIN_TIER and up), hashed into the ledger and
# then posted to a webhook (Discord/Slack JSON) and/or a Telegram chat. Unset: the record still shows on the site.
# CALLOUT_WEBHOOK_URL=
# CALLOUT_TG_TOKEN=
# CALLOUT_TG_CHAT_ID=
# CALLOUT_MIN_TIER=2
# Prepended to the /halt and /status links inside each alert, so the message is actionable.
# PUBLIC_URL=https://your-app.up.railway.app

# ── Support / operations ──
# Lets an operator act for a user on the money routes with the X-Admin-Secret header. Also required
# by tools/launch-push.mjs. Unset means no override exists at all, which is the safer default.
# ADMIN_SECRET=
# Per-user performance fee, percent of profit. Default is the value baked into the hub.
# VELOCITY_FEE_PCT=
# Floor under the sizer, in dollars. Default 10, derived from the router's cost constants: a round
# trip costs $0.12 fixed plus 3% of the stake, so the drag is 4.2% at $10 and 3.5% at $25 and the
# extra diversification is worth the gap. Below $10 the fixed part starts to bite again.
# MIN_STAKE_USD=10
# On-chain slippage tolerance for our own pump.fun transactions, percent. Defaults 15/15.
# BUY_SLIPPAGE=15
# SELL_SLIPPAGE=15

# Nothing outside is polled unless someone is trading: feeds, streams and pollers start on the first bot
# and stop ACTIVITY_GRACE_MIN minutes after the last one stops. ALWAYS_ON=1 keeps them running regardless.
# ACTIVITY_GRACE_MIN=10
# ALWAYS_ON=0
